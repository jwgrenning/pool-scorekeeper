<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PoolScorekeeper">

        <activity
            android:name="net.grenning.pool_scorekeeper.ChooseGame"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="net.grenning.pool_scorekeeper.straight_pool.StartGameActivity"
            android:label="@string/title_activity_straight_pool_start" />

        <activity
            android:name="net.grenning.pool_scorekeeper.straight_pool.GameScoreActivity"
            android:label="@string/title_activity_score_straight_pool"
            android:screenOrientation="landscape" />

        <activity
            android:name="net.grenning.pool_scorekeeper.straight_pool.GameSummaryActivity"
            android:label="@string/game_summary" />

        <activity
            android:name="net.grenning.pool_scorekeeper.cowboy.CowboyPoolStartActivity"
            android:label="@string/title_activity_cowboy_pool_start" />

        <activity
            android:name="net.grenning.pool_scorekeeper.cowboy.CowboyScoreActivity"
            android:label="@string/title_activity_cowboy_pool_start"
            android:screenOrientation="landscape" />
    </application>

</manifest>
