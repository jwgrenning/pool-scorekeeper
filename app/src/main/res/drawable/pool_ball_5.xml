<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_enabled="false">
                <layer-list>
                    <item>
                        <shape android:shape="oval">
                            <gradient
                                android:type="radial"
                                android:gradientRadius="52%p"
                                android:centerX="0.32"
                                android:centerY="0.28"
                                android:startColor="#66FF9E40"
                                android:endColor="#668A3A00" />
                        </shape>
                    </item>
                    <item
                        android:left="12dp"
                        android:top="7dp"
                        android:right="28dp"
                        android:bottom="33dp">
                        <shape android:shape="oval">
                            <solid android:color="#33FFFFFF" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_checked="true">
                <layer-list>
                    <item>
                        <shape android:shape="oval">
                            <gradient
                                android:type="radial"
                                android:gradientRadius="52%p"
                                android:centerX="0.32"
                                android:centerY="0.28"
                                android:startColor="#FFB74D"
                                android:endColor="#8A3A00" />
                            <stroke
                                android:width="2.5dp"
                                android:color="#FFFFFFFF" />
                        </shape>
                    </item>
                    <item
                        android:left="12dp"
                        android:top="7dp"
                        android:right="28dp"
                        android:bottom="33dp">
                        <shape android:shape="oval">
                            <gradient
                                android:type="radial"
                                android:gradientRadius="90%p"
                                android:centerX="0.45"
                                android:centerY="0.40"
                                android:startColor="#CCFFFFFF"
                                android:endColor="#00FFFFFF" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_pressed="true">
                <layer-list>
                    <item>
                        <shape android:shape="oval">
                            <gradient
                                android:type="radial"
                                android:gradientRadius="52%p"
                                android:centerX="0.36"
                                android:centerY="0.34"
                                android:startColor="#FB8C00"
                                android:endColor="#6A2C00" />
                        </shape>
                    </item>
                    <item
                        android:left="13dp"
                        android:top="9dp"
                        android:right="29dp"
                        android:bottom="34dp">
                        <shape android:shape="oval">
                            <solid android:color="#55FFFFFF" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="oval">
                            <gradient
                                android:type="radial"
                                android:gradientRadius="52%p"
                                android:centerX="0.32"
                                android:centerY="0.28"
                                android:startColor="#FFB74D"
                                android:endColor="#8A3A00" />
                        </shape>
                    </item>
                    <item
                        android:left="12dp"
                        android:top="7dp"
                        android:right="28dp"
                        android:bottom="33dp">
                        <shape android:shape="oval">
                            <gradient
                                android:type="radial"
                                android:gradientRadius="90%p"
                                android:centerX="0.45"
                                android:centerY="0.40"
                                android:startColor="#CCFFFFFF"
                                android:endColor="#00FFFFFF" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="oval">
                            <stroke
                                android:width="1dp"
                                android:color="#55FFFFFF" />
                            <solid android:color="@android:color/transparent" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
