<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scoreRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/felt_dark"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/scoreToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/felt_green"
        android:minHeight="?attr/actionBarSize"
        app:title="@string/default_inning_text"
        app:titleTextColor="@color/ivory" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/ballsOnTheTable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/default_balls_left_on_the_table"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/ivory" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newRackButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:onClick="newRackButtonClicked"
            android:text="@string/new_rack" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/player1Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/inactive_player"
            app:cardCornerRadius="12dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/active_player"
            app:strokeWidth="0dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:stretchColumns="1">

                <TableRow>
                    <TextView
                        android:id="@+id/player1Name"
                        android:layout_span="2"
                        android:gravity="center"
                        android:text="@string/default_player1Name"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                        android:textColor="@color/ivory"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/game_total" />
                    <TextView
                        android:id="@+id/player1Score"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0"
                        android:textSize="28sp" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/points_needed" />
                    <TextView
                        android:id="@+id/player1PointsToWin"
                        style="@style/Widget.Pool.StatValue"
                        android:text="50" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/current_rack_total" />
                    <TextView
                        android:id="@+id/player1BallsThisRack"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/current_run" />
                    <TextView
                        android:id="@+id/player1CurrentRun"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/longest_run" />
                    <TextView
                        android:id="@+id/player1LongestRun"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/safes_made" />
                    <TextView
                        android:id="@+id/player1SafesMade"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/consecutive_fouls" />
                    <TextView
                        android:id="@+id/player1ConsecutiveFouls"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/total_fouls" />
                    <TextView
                        android:id="@+id/player1TotalFouls"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>
            </TableLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/player2Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/inactive_player"
            app:cardCornerRadius="12dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/active_player"
            app:strokeWidth="0dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:stretchColumns="1">

                <TableRow>
                    <TextView
                        android:id="@+id/player2Name"
                        android:layout_span="2"
                        android:gravity="center"
                        android:text="@string/default_player2Name"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                        android:textColor="@color/ivory"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/game_total" />
                    <TextView
                        android:id="@+id/player2Score"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0"
                        android:textSize="28sp" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/points_needed" />
                    <TextView
                        android:id="@+id/player2PointsToWin"
                        style="@style/Widget.Pool.StatValue"
                        android:text="50" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/current_rack_total" />
                    <TextView
                        android:id="@+id/player2BallsThisRack"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/current_run" />
                    <TextView
                        android:id="@+id/player2CurrentRun"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/longest_run" />
                    <TextView
                        android:id="@+id/player2LongestRun"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/safes_made" />
                    <TextView
                        android:id="@+id/player2SafesMade"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/consecutive_fouls" />
                    <TextView
                        android:id="@+id/player2ConsecutiveFouls"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>

                <TableRow>
                    <TextView
                        style="@style/Widget.Pool.StatLabel"
                        android:text="@string/total_fouls" />
                    <TextView
                        android:id="@+id/player2TotalFouls"
                        style="@style/Widget.Pool.StatValue"
                        android:text="0" />
                </TableRow>
            </TableLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shotMadeButton"
                style="@style/Widget.Pool.ActionButton"
                android:onClick="shotMadeButtonClicked"
                android:text="@string/shot_made" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/safeMadeButton"
                style="@style/Widget.Pool.ActionButton"
                android:onClick="safeMadeButtonClicked"
                android:text="@string/safe_made" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/missedShotButton"
                style="@style/Widget.Pool.DangerButton"
                android:onClick="missedShotButtonClicked"
                android:text="@string/missed_shot" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/foulButton"
                style="@style/Widget.Pool.DangerButton"
                android:onClick="foulButtonClicked"
                android:text="@string/foul" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/undoButton"
                style="@style/Widget.Pool.SplitButton.Left"
                android:layout_marginEnd="1dp"
                android:contentDescription="@string/undo"
                android:enabled="false"
                android:onClick="undoButtonClicked"
                android:text="@string/undo_symbol" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/redoButton"
                style="@style/Widget.Pool.SplitButton.Right"
                android:contentDescription="@string/redo"
                android:enabled="false"
                android:onClick="redoButtonClicked"
                android:text="@string/redo_symbol" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
