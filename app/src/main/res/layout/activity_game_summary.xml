<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/felt_dark"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/summaryToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/felt_green"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/ivory"
        app:title="@string/game_summary"
        app:titleTextColor="@color/ivory" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@color/inactive_player"
            app:cardCornerRadius="12dp"
            app:contentPadding="16dp">

            <TextView
                android:id="@+id/summaryBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/ivory"
                android:textIsSelectable="true" />
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/shareButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:minHeight="56dp"
        android:onClick="shareButtonClicked"
        android:text="@string/share"
        android:textAllCaps="false"
        app:icon="@drawable/ic_share"
        app:iconGravity="textStart"
        app:iconTint="@color/ivory" />

</LinearLayout>
